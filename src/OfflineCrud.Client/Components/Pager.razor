@* Previous/next paging with a short window of page numbers. Reports the chosen page through OnPageSelected. *@

@if (PageCount > 1)
{
    <nav aria-label="Pages">
        <ul class="pagination mb-0 flex-wrap">
            <li class="page-item @(PageNumber <= 1 ? "disabled" : null)">
                <button type="button" class="page-link" aria-label="Previous page" @onclick="() => SelectAsync(PageNumber - 1)">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
            </li>
            @foreach (int number in VisiblePages())
            {
                <li class="page-item @(number == PageNumber ? "active" : null)">
                    <button type="button" class="page-link" aria-current="@(number == PageNumber ? "page" : null)"
                            @onclick="() => SelectAsync(number)">@number</button>
                </li>
            }
            <li class="page-item @(PageNumber >= PageCount ? "disabled" : null)">
                <button type="button" class="page-link" aria-label="Next page" @onclick="() => SelectAsync(PageNumber + 1)">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </li>
        </ul>
    </nav>
}

@code {
    private const int WindowSize = 5;

    /// <summary>The current 1-based page.</summary>
    [Parameter]
    public int PageNumber { get; set; } = 1;

    /// <summary>The total number of pages.</summary>
    [Parameter]
    public int PageCount { get; set; } = 1;

    /// <summary>Invoked with the 1-based page the user picked.</summary>
    [Parameter]
    public EventCallback<int> OnPageSelected { get; set; }

    private IEnumerable<int> VisiblePages()
    {
        int first = Math.Max(1, PageNumber - (WindowSize / 2));
        int last = Math.Min(PageCount, first + WindowSize - 1);
        first = Math.Max(1, last - WindowSize + 1);
        return Enumerable.Range(first, last - first + 1);
    }

    private async Task SelectAsync(int page)
    {
        if (page >= 1 && page <= PageCount && page != PageNumber)
        {
            await OnPageSelected.InvokeAsync(page);
        }
    }
}
