<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- LEARN: Two service workers. Under `dotnet run` the browser gets service-worker.js, which does nothing,
         so you always see fresh code. Only `dotnet publish` swaps in service-worker.published.js, which caches
         the app shell for offline start-up. -->
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfflineCrud.Application\OfflineCrud.Application.csproj" />
    <!-- The client is the composition root, so it references Infrastructure only to register implementations
         in Program.cs. Pages and components depend on Application interfaces, never on Infrastructure types. -->
    <ProjectReference Include="..\OfflineCrud.Infrastructure\OfflineCrud.Infrastructure.csproj" />
  </ItemGroup>

</Project>
