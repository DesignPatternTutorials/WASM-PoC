<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- LEARN: This is a Razor class library rather than a plain class library so that files in its wwwroot
       (the hand-rolled IndexedDB JS module) are shipped as static web assets. The client loads them from
       "./_content/OfflineCrud.Infrastructure/js/...", and the published service worker caches them with the
       rest of the app shell. -->

  <ItemGroup>
    <!-- Lets the browser-compatibility analyser flag APIs that don't work in WebAssembly. -->
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.JSInterop" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OfflineCrud.Application\OfflineCrud.Application.csproj" />
  </ItemGroup>

</Project>
